+    /// Cuts deleted split segments out of the composition and returns the removed timeline seconds.
+    private static func removeDeletedSegments(
+        of video: Video,
+        from composition: AVMutableComposition
+    ) -> Double {
+        guard video.rate.isFinite, video.rate > 0 else { return 0 }
+
+        let rate = Double(video.rate)
+        let removedRanges = VideoSplitEditor.effectiveRemovedRanges(
+            trim: video.rangeDuration,
+            removedRanges: video.removedRanges
+        )
+        var removedTimelineDuration = 0.0
+
+        // Remove back-to-front so earlier ranges keep their original positions.
+        for range in removedRanges.reversed() {
+            let start = CMTimeMakeWithSeconds(range.lowerBound / rate, preferredTimescale: 1000)
+            let end = CMTimeMakeWithSeconds(range.upperBound / rate, preferredTimescale: 1000)
+
+            guard end > start else { continue }
+
+            composition.removeTimeRange(CMTimeRangeFromTimeToTime(start: start, end: end))
+            removedTimelineDuration += (range.upperBound - range.lowerBound) / rate
+        }
+
+        return removedTimelineDuration
+    }
